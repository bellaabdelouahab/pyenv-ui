<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane style="-fx-background-color: #232323;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.bellaabdelouahab.pyenvcontroller.src.HelloController">
    <!-- Header -->
    <Label fx:id="mainLabel" layoutX="20" layoutY="20" styleClass="label-main" text="PyEnv Version Manager" textFill="#950f97">
        <font>
            <Font name="Segoe UI" size="36.0" />
        </font>
    </Label>

    <!-- Main Content Area -->
    <HBox layoutX="20.0" layoutY="72.0" prefHeight="680" prefWidth="1240" spacing="20">
        <!-- Left Pane: Python Versions -->
        <VBox prefWidth="300.0" spacing="10" style="-fx-background-color: #2e2e2e;" VBox.vgrow="ALWAYS">
            <children>
                <!-- Search Bar for Python Versions -->
                <TextField fx:id="versionSearchField" promptText="Search Python Versions" />

                <!-- List of Python Versions -->
                <ScrollPane fx:id="scrollPaneVersions" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="avaialeversions" alignment="TOP_CENTER" spacing="10" />
                    </content>
                </ScrollPane>

                <!-- Install Button -->
                <Button fx:id="installButton" onAction="#handleInstallButton" prefHeight="25.0" prefWidth="307.0" styleClass="button" text="Install Selected Version" />

                <!-- Switch Button -->
                <Button fx:id="switchButton" onAction="#handleSwitchButton" prefHeight="25.0" prefWidth="311.0" styleClass="button" text="Switch to Selected Version" />
            </children>
        </VBox>

        <!-- Right Pane: Python Packages -->
        <VBox prefWidth="900.0" spacing="10" style="-fx-background-color: #2e2e2e;" VBox.vgrow="ALWAYS">
            <children>
                <!-- Search Bar for Packages with Install Button -->
                <HBox spacing="10">
                    <TextField fx:id="packageSearchField" promptText="Search Packages" HBox.hgrow="ALWAYS" />
                    <Button fx:id="installPackageButton" disable="true" onAction="#handleInstallPackageButton" prefWidth="140.0" styleClass="button" text="Install Package" />
                </HBox>

                <!-- VBox for Packages with Sticky Header -->
                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Header Row -->
                        <HBox fx:id="packageHeaderRow" alignment="CENTER" fillHeight="false" spacing="10" style="-fx-background-color: #2e2e2e; -fx-padding: 5; -fx-border-color: #2e2e2e; -fx-border-width: 1;">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 150px; -fx-alignment: center;" text="Name" />
                            <HBox prefHeight="17.0" prefWidth="592.0" HBox.hgrow="ALWAYS" />
                            <Label minWidth="190.0" prefHeight="17.0" prefWidth="166.0" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 100px; -fx-alignment: center;" text="Version" />
                        </HBox>

                        <!-- ScrollPane for Packages -->
                        <ScrollPane fx:id="scrollPanePackages" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="packageVBox" spacing="10" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <!-- Package Management Buttons -->
                <HBox spacing="10">
                    <Button fx:id="uninstallPackageButton" onAction="#handleUninstallPackageButton" prefWidth="140.0" styleClass="button" text="Uninstall Package" />
                </HBox>
            </children>
        </VBox>
    </HBox>

    <!-- Status Bar -->
    <Label fx:id="statusLabel" alignment="TOP_CENTER" contentDisplay="TOP" layoutX="20.0" layoutY="755.0" prefHeight="43.0" prefWidth="1219.0" style="-fx-text-fill: white; -fx-padding: 5; -fx-border-color: red; -fx-border-radius: 5;" text="Ready" textFill="#6b6565" />
</Pane>
